rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // USERS
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /family_members/{memberId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // TECHNICIANS
    match /technicians/{phone} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.phoneNumber == phone;
      allow delete: if false;
    }

    // SERVICE REQUESTS
    match /requests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || resource.data.technicianId == request.auth.phoneNumber
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || resource.data.technicianId == request.auth.phoneNumber
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // SPECIALIZED REQUESTS
    match /carpentry_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.technicianId == request.auth.phoneNumber);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.technicianId == request.auth.phoneNumber);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /plumbing_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.technicianId == request.auth.phoneNumber);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.technicianId == request.auth.phoneNumber);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /painting_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.technicianId == request.auth.phoneNumber);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.technicianId == request.auth.phoneNumber);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // OFFERS
    match /offers/{offerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.technicianId == request.auth.phoneNumber;
      allow update: if request.auth != null && resource.data.technicianId == request.auth.phoneNumber;
      allow delete: if request.auth != null && resource.data.technicianId == request.auth.phoneNumber;
    }

    // VERIFIED
    match /verified/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == docId;
      allow update: if request.auth != null && request.auth.uid == docId;
      allow delete: if false;
    }

    // PAYMENT CARDS
    match /PaymentCards/{cardId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // TRANSACTIONS
    match /transactions/{txnId} {
      allow read: if request.auth != null && resource.data.technicianId == request.auth.phoneNumber;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // POSTS (Community) — hardened Phase 4: authorId required
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || request.resource.data.authorId == request.auth.uid);
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // CONVERSATIONS (Chat)
    match /conversations/{convId} {
      allow read: if request.auth != null && (
        resource.data.customerId == request.auth.uid
        || resource.data.technicianId == request.auth.phoneNumber
      );
      allow create: if request.auth != null;

      match /messages/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }

    // ORDERS (legacy)
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}